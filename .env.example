# -------------------------------------------------------------
# NÚCLEO FINANCIERO - CONFIGURACIÓN DE ENTORNO
# -------------------------------------------------------------

# Aplicación
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Base de Datos PostgreSQL (Multi-tenant Schema-per-Tenant)
# Host en docker: postgres | Host en local: localhost
DB_HOST=localhost
DB_PORT=5432
DB_USER=nucleo_admin
DB_PASSWORD=nucleo_secure_pass_2026
DB_NAME=nucleo_financiero_db
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Almacenamiento en Bucket (MinIO local / AWS S3 producción)
# Valores permitidos para STORAGE_PROVIDER: minio | s3 | r2
STORAGE_PROVIDER=minio

# Para MinIO local (puerto API S3: 9000, consola web: 9001)
# Para AWS S3 en producción, dejar STORAGE_ENDPOINT vacío o usar https://s3.{region}.amazonaws.com
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=nucleo-financiero-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123
STORAGE_FORCE_PATH_STYLE=true

# URL base pública para acceder a MinIO o CDN (si aplica)
STORAGE_PUBLIC_URL=http://localhost:9000

# Límites y Políticas de Storage
MAX_FILE_SIZE_BYTES=52428800 # 50 MB
PRESIGNED_URL_EXPIRES_SECONDS=900 # 15 minutos
